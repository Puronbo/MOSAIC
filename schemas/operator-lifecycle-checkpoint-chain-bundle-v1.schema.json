{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosaic.example/schemas/operator-lifecycle-checkpoint-chain-bundle-v1.schema.json",
  "title": "MOSAIC portable operator lifecycle checkpoint-chain bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "starting_sequence",
    "starting_checkpoint_sha256",
    "checkpoints"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "registry_id": { "type": "string", "minLength": 1, "maxLength": 200 },
    "starting_sequence": { "type": "integer", "minimum": 0 },
    "starting_checkpoint_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "checkpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "operator-lifecycle-checkpoint-v1.schema.json"
      }
    }
  }
}
