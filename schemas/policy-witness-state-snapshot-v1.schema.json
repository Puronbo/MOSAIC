{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosaic.example/schemas/policy-witness-state-snapshot-v1.schema.json",
  "title": "MOSAIC Signed Policy Witness State Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "log_id", "checkpoint", "quarantined", "incidents", "witness_key_id", "exported_at_utc", "signature_b64"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "log_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "checkpoint": {"$ref": "policy-registry-checkpoint-v1.schema.json"},
    "quarantined": {"type": "boolean"},
    "incidents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "retained_checkpoint_sha256", "conflicting_checkpoint_sha256", "reason", "observed_at_utc"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 0},
          "retained_checkpoint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "conflicting_checkpoint_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "reason": {"type": "string", "minLength": 1, "maxLength": 2000},
          "observed_at_utc": {"type": "string", "format": "date-time"}
        }
      }
    },
    "witness_key_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "exported_at_utc": {"type": "string", "format": "date-time"},
    "signature_b64": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}