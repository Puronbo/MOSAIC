{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Puronbo/MOSAIC/blob/main/schemas/policy-witness-recovery-policy-v1.schema.json",
  "title": "MOSAIC Recovery Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "minimum_approvals",
    "required_operator_key_ids",
    "prohibited_operator_key_ids"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "minimum_approvals": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "required_operator_key_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prohibited_operator_key_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
