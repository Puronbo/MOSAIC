{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Puronbo/MOSAIC/blob/main/schemas/policy-witness-recovery-policy-checkpoint-v1.schema.json",
  "title": "MOSAIC Signed Recovery Policy Checkpoint v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_id",
    "sequence",
    "entry_sha256",
    "issued_at_utc",
    "signer_key_id",
    "signature_b64"
  ],
  "properties": {
    "schema_version": {
      "const": "mosaic.policy-witness-recovery-policy-checkpoint.v1"
    },
    "registry_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "entry_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "issued_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "signer_key_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "signature_b64": {
      "type": "string",
      "minLength": 88,
      "maxLength": 88
    }
  }
}
