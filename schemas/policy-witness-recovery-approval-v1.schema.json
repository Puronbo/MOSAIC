{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mosaic.example/schemas/policy-witness-recovery-approval-v1.schema.json",
  "title": "MOSAIC Signed Policy Witness Recovery Approval v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authorization_sha256", "operator_key_id", "approved_at_utc", "signature_b64"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "authorization_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "operator_key_id": { "type": "string", "minLength": 1, "maxLength": 160 },
    "approved_at_utc": { "type": "string", "format": "date-time" },
    "signature_b64": { "type": "string", "minLength": 1, "maxLength": 128 }
  }
}
